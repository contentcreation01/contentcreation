# ==============================================================================
# Git Ignore Configuration for AI Content Creation Pipeline
# ==============================================================================

# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class
*.tmp

# ==============================================================================
# ⚠️  CREATOR CONTENT PROTECTION — Downloaded creator data stays LOCAL ONLY
# ==============================================================================
# These folders contain extracted transcripts, captions, cover thumbnails,
# and metadata from real creators (Luke, Chandler, Cindy, Sagar, etc.)
# This content belongs to the original creators — NEVER commit it publicly.
# Your friends will download their own content using the pipeline tools.
Instagram/Reels/*/
YouTube/Shorts/*/
YouTube/Videos/*/
TikTok/*/
Twitter/*/
# Allow .gitkeep files to preserve folder structure
!Instagram/Reels/.gitkeep
!Instagram/Reels/Strategy_Cracks/.gitkeep
!Instagram/Posts/.gitkeep
!YouTube/Shorts/.gitkeep
!YouTube/Videos/.gitkeep
!TikTok/.gitkeep
!Twitter/.gitkeep
# Allow Strategy_Cracks session folders (your own AI-generated output)
!Instagram/Reels/Strategy_Cracks/
Instagram/Reels/Strategy_Cracks/*/

# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Large AI Model Weights (>100MB exceeds GitHub limits)
# Run `python3 Pipeline_Tools/Setup_Dependencies/download_models.py` after cloning!
Pipeline_Tools/models/*.bin
*.bin

# Local Agent conversation transcripts and IDE config
.agents/
.idea/
.vscode/
*.swp
*.swo

# Large raw video and audio binaries in content folders
# (Protects git repository size; run pipeline to download fresh streams)
*.mp4
*.mp3
*.m4a
*.wav
*.aiff
*.zip
*.tar.gz

# Strategy Crack session audio and video exports (large files)
# The .md reports ARE committed; only raw media is excluded
Instagram/Reels/Strategy_Cracks/**/*.mp4
Instagram/Reels/Strategy_Cracks/**/*.mp3
Instagram/Reels/Strategy_Cracks/**/*.wav

# Local test output files
test_*.py
*_test_output/
scratch/

# Python virtual environments (if user creates one)
venv/
.venv/
env/
.env

# Retain directory structure with .gitkeep
!**/.gitkeep
